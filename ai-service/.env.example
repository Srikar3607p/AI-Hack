# Groq API Key — leave blank to use built-in rule-based fallback
GROQ_API_KEY=

# Server binding
PORT=8000
HOST=0.0.0.0

# AI Model — can be changed without code changes
AI_MODEL=llama-3.3-70b-versatile
VISION_MODEL=llama-3.2-11b-vision-preview

# Node.js Backend URL (used by AI service to call back if needed)
NODE_BACKEND_URL=http://localhost:5000
